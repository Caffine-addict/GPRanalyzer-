# Copy to .env (gitignored) and fill in. Never commit real values.

# Groq API key for the reasoning layer (reason/engine.py). Get one at
# https://console.groq.com/keys
GROQ_API_KEY=

# Postgres (compose.yaml): pick a long random password; the URLs reuse it.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://gpr:<password>@127.0.0.1:5432/gpr
TEST_DATABASE_URL=postgresql://gpr:<password>@127.0.0.1:5432/gpr_test
